# NEXUS AI — config/nexus.env
# Configuracion centralizada de PATH y variables de entorno.
# Generado por install.sh. No editar manualmente.
# Las instalaciones existentes sin este archivo mantienen
# el comportamiento anterior (PATH inline en .zshrc/.bashrc).

# NEXUS_ROOT se auto-detecta en config/env.sh (no sobreescribir)

# Termux bind-mount dirs (runtime-checked)
if [ -d "/data/data/com.termux/files/usr/bin" ]; then
    case ":${PATH}:" in
        *":/data/data/com.termux/files/usr/bin:"*) ;;
        *) export PATH="/data/data/com.termux/files/usr/bin:${PATH}" ;;
    esac
fi
if [ -d "/data/data/com.termux/files/usr/local/bin" ]; then
    case ":${PATH}:" in
        *":/data/data/com.termux/files/usr/local/bin:"*) ;;
        *) export PATH="/data/data/com.termux/files/usr/local/bin:${PATH}" ;;
    esac
fi
# ~/.local/bin (uv, fabric, etc.)
if [ -d "${HOME}/.local/bin" ]; then
    case ":${PATH}:" in
        *":${HOME}/.local/bin:"*) ;;
        *) export PATH="${HOME}/.local/bin:${PATH}" ;;
    esac
fi
# NEXUS_ROOT/bin
case ":${PATH}:" in
    *":${NEXUS_ROOT}/bin:"*) ;;
    *) export PATH="${NEXUS_ROOT}/bin:${PATH}" ;;
esac
