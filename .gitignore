.antigravitycli/
TESTING-*.md
*.bak
*.tmp
*.swp
*.swo
*~

# ── Entorno y credenciales ───────────────────────
.env
.env.*
!.env.example
*.key
*.pem
*.cert

# ── Sistema ─────────────────────────────────────
.DS_Store
Thumbs.db
